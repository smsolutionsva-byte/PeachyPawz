{
  "manifest_version": 3,
  "name": "Ask Peachy — PeachyPawz Companion",
  "version": "0.1.0",
  "description": "Capture visible pet-health information from the current page and review it in PeachyPawz.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Ask Peachy",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://peachypawz.vercel.app/*", "http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
