{
  "name": "PeachyPawz",
  "short_name": "PeachyPawz",
  "description": "A clearer story for every paw.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fffaf5",
  "theme_color": "#f4a261",
  "icons": [
    {
      "src": "/icons/peachy-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/peachy-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".pdf"
          ]
        }
      ]
    }
  }
}
