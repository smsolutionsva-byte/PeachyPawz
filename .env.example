# Authentication (required)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public canonical URL (optional; useful for provider attribution/callback docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider: groq (recommended hackathon default), openrouter, or openai.
AI_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# OpenRouter alternative
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free

# OpenAI alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5

# Future production persistence adapter
MONGODB_URI=
