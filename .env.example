# Authentication (required)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI provider. Groq is the recommended hackathon default.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional fallback if you later switch AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5

# Future production persistence adapter
MONGODB_URI=
